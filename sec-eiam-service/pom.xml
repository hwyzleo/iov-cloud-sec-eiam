<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>net.hwyz.iov.cloud.sec</groupId>
    <artifactId>sec-eiam-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <edd-mpt-version>0.0.1-SNAPSHOT</edd-mpt-version>
        <edd-org-version>0.0.1-SNAPSHOT</edd-org-version>
    </properties>

    <dependencies>
        <!-- 框架：安全 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-security-starter</artifactId>
        </dependency>

        <!-- 框架：Redis -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-redis-starter</artifactId>
        </dependency>

        <!-- xml绑定 -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>

        <!-- 框架：MySQL（身份目录持久化，SEC-EIAM-DSN-CR-002） -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-mysql-starter</artifactId>
        </dependency>

        <!-- 组织服务接口（员工增量同步） -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-org-api</artifactId>
            <version>${edd-org-version}</version>
        </dependency>

        <!-- 管理后台系统接口 -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-mpt-api</artifactId>
            <version>${edd-mpt-version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Parent 全局 skip=true（CI 默认），SEC-EIAM-DSN-CR-001 的契约测试须可执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
